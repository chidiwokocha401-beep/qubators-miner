{
  "name": "qubators-miner",
  "productName": "QubatorsMiner",
  "version": "1.1.0",
  "description": "Qubators Miner — Learn Cloud Mining (desktop app)",
  "main": "main.js",
  "scripts": {
    "setup": "node copy-assets.js",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qubators.miner",
    "productName": "QubatorsMiner",
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education"
    },
    "portable": {
      "artifactName": "qubators-miner-windows.exe"
    },
    "dmg": {
      "artifactName": "qubators-miner-macos.dmg"
    }
  }
}
